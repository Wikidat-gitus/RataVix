# ==========================================
# ⚙️ Baúl Mágico 2 — Configuración Backend
# ==========================================

# Entorno y Servidor
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# Base de Datos PostgreSQL (Local con Docker o Remota)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baul_magico_db

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Seguridad y Sesión Backend (Criptografía de sesión)
SECRET_KEY=clave_secreta_para_firmar_tokens_de_sesion_backend_minimo_32_caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
